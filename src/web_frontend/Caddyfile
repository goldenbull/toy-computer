{
        debug
}

https://toycomputer.net {
        tls /etc/ssl/toycomputer.net/fullchain.pem /etc/ssl/toycomputer.net/privkey.pem

        # site1
        redir /clever-blocks /clever-blocks/
        handle_path /clever-blocks/* {
                reverse_proxy 127.0.0.1:8000
        }

        # site2
        redir /sudoku /sudoku/
        handle_path /sudoku/* {
                root * /var/www/sudoku/web
                file_server
        }

        # site3
        redir /quant-ai /quant-ai/
        handle_path /quant-ai/* {
                root * /var/www/lecture
                try_files {path} /index.html
                file_server
        }

        # default
        handle {
                root * /var/www/toycomputer/build
                try_files {path} {path}.html /index.html
                file_server

                @asm path *.asm
                header @asm Content-Type "text/plain; charset=utf-8"
        }
}

